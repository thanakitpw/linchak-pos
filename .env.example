# คัดลอกเป็น .env.local แล้วใส่ค่าจริง — .env.local ถูก gitignore ไว้
# ค่าทั้งหมดหาได้ที่ Supabase Dashboard → Project Settings → API Keys

# ── ใช้ได้ทั้งฝั่ง browser และ server ────────────────────────────────────────
# URL ของโปรเจค (ประกอบจาก project ref ได้ตรงๆ)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# publishable key — ออกแบบมาให้เปิดเผยได้ ถูกส่งไปกับ browser อยู่แล้ว
# ความปลอดภัยไม่ได้มาจากการซ่อน key นี้ แต่มาจาก RLS (ดู CLAUDE.md ข้อ 26)
#
# ⚠️ ใช้ key รูปแบบใหม่ (sb_publishable_...) ไม่ใช่ anon key แบบ JWT
#    anon / service_role เป็นรุ่นเก่าของ publishable / secret และ
#    Supabase ประกาศว่าจะเลิกใช้สิ้นปี 2026 — โปรเจคใหม่ไม่มีเหตุผลจะเริ่มด้วยของเก่า
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ── ฝั่ง server เท่านั้น ─────────────────────────────────────────────────────
# ⚠️ secret key ข้ามผ่าน RLS ได้ทั้งหมด = ทุก query เห็นข้อมูลทุกร้าน
#    - ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด (จะหลุดไป browser ทันที)
#    - ห้าม import ในไฟล์ที่มี "use client"
#
# ตั้งใจไม่ใส่ และอาจไม่ต้องใส่เลย:
# หน้า /admin ใช้ RLS policy ที่ตรวจ is_platform_admin() แทนการ bypass
# ดีกว่า 3 อย่าง — audit บันทึกได้ว่าใครทำจริง / policy ผิดหนึ่งตารางไม่รั่วทั้งระบบ /
# นโยบายอยู่ใน migration ที่อ่านและ test ได้ ไม่ใช่สวิตช์ที่มองไม่เห็นในโค้ด
# จะจำเป็นก็ต่อเมื่อมีงานที่ไม่มี user session เลย เช่น cron ตัดรอบ หรือ webhook
# จาก payment gateway (เฟสหลัง) — ดู docs/data-model.md §9
# SUPABASE_SECRET_KEY="sb_secret_..."

# ── ใช้กับ Supabase CLI ตอนทำ migration (ไม่ต้องมีในตอนรันแอป) ──────────────
# SUPABASE_PROJECT_REF="<project-ref>"
# SUPABASE_DB_PASSWORD=""
